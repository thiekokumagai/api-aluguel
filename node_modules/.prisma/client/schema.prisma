generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  document  String?  @unique // CNPJ or CPF
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  properties Property[]
  renters    Renter[]
}

model Property {
  id             String       @id @default(uuid())
  address        String
  description    String?
  status         String       @default("AVAILABLE") // AVAILABLE, RENTED, MAINTENANCE
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Renter {
  id             String       @id @default(uuid())
  name           String
  email          String?
  phone          String?
  document       String // CPF / CNPJ
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, document])
  @@index([organizationId])
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  password       String
  name           String
  role           String        @default("ADMIN") // SUPER_ADMIN or ADMIN
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
}
